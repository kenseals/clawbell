PORT=4181
REQUIRE_ADMIN_AUTH=1
ADMIN_TOKEN=replace-with-long-random-token
# Cloudflare Worker mode can use CLAWBELL_CONFIG_JSON as a Worker var/secret.
CLAWBELL_CONFIG_JSON=
# Required when trusted custom sites send request-scoped siteConfig.
CLAWBELL_SITE_CONFIG_TOKEN=replace-with-long-random-token
ENABLE_AGENT_BRIDGE=1
OPENCLAW_BIN=openclaw
AGENT_BRIDGE_SESSION_ID=public-clawbell-session
AGENT_BRIDGE_URL=https://example-bridge/ask
AGENT_BRIDGE_TOKEN=replace-with-long-random-token
AGENT_BRIDGE_RATE_LIMIT_WINDOW_MS=3600000
AGENT_BRIDGE_RATE_LIMIT_MAX=20
AGENT_BRIDGE_GLOBAL_RATE_LIMIT_MAX=150
AGENT_BRIDGE_MAX_CONCURRENT=1
AGENT_BRIDGE_QUEUE_ENABLED=1
AGENT_BRIDGE_QUEUE_MAX_DEPTH=3
AGENT_BRIDGE_QUEUE_TIMEOUT_MS=20000
AGENT_BRIDGE_QUEUE_POLL_MS=250
# Optional when the bridge hostname is protected by Cloudflare Access.
AGENT_BRIDGE_ACCESS_CLIENT_ID=
AGENT_BRIDGE_ACCESS_CLIENT_SECRET=
MAX_MESSAGE_CHARS=1200
# Node app uses in-process rate buckets. Cloudflare Worker mode uses RATE_LIMIT_MODE=auto
# to prefer the RATE_LIMITER Durable Object binding when configured, then falls back to memory.
RATE_LIMIT_MODE=auto
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=12
DATA_DIR=./data

# Deprecated aliases still supported for existing dogfood deployments:
# ENABLE_SOREN_BRIDGE=1
# SOREN_SESSION_ID=public-clawbell-session
# SOREN_BRIDGE_URL=https://example-bridge/ask
# SOREN_BRIDGE_TOKEN=replace-with-long-random-token
# SOREN_BRIDGE_RATE_LIMIT_WINDOW_MS=3600000
# SOREN_BRIDGE_RATE_LIMIT_MAX=20
# SOREN_BRIDGE_GLOBAL_RATE_LIMIT_MAX=150
# SOREN_BRIDGE_MAX_CONCURRENT=1
# SOREN_BRIDGE_QUEUE_ENABLED=1
# SOREN_BRIDGE_QUEUE_MAX_DEPTH=3
# SOREN_BRIDGE_QUEUE_TIMEOUT_MS=20000
# SOREN_BRIDGE_QUEUE_POLL_MS=250
